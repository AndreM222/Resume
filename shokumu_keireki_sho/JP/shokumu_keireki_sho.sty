\ifx#1\empty\edef#1{#2}
\else\edef#1{#1,#2}
\fi
}
\def\分解七#1:#2:#3:#4:#5:#6:#7:{
\def\one{#1}\def\two{#2}\def\three{#3}\def\four{#4}\def\five{#5}\def\six{#6}\def\seven{#7}
}

\def\分解四#1:#2:#3:#4:{
\def\one{#1}\def\two{#2}\def\three{#3}\def\four{#4}
}
